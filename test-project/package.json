{
  "name": "archify-local-tests",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "playwright test",
    "flow": "node support/commands.mjs flow",
    "check:framework": "node --test framework/*.test.mjs",
    "check:types": "tsc --noEmit",
    "check:ui-evidence": "node support/check-ui-evidence.mjs",
    "features:validate": "node support/feature-map-cli.mjs validate",
    "features:apply": "node support/feature-map-cli.mjs apply",
    "cases:check": "node support/case-plan-cli.mjs",
    "test:api": "node support/commands.mjs api",
    "test:web": "node support/commands.mjs web",
    "test:android": "node support/commands.mjs android",
    "test:ui": "node support/commands.mjs ui"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
