# 由初始設定寫入本機 .env；此範本不保存個人來源路徑
ARCHIFY_SOURCE_DIR=
# 複製為 .env；由獨立 npm test 載入，不提交秘密。
# 要連線驗證的 dev／QA BFF（中間層）網址；GraphQL 請包含 /graphql。此處填測試環境，不是 Archify 網頁網址。
BFF_BASE_URL=
# 共用 Header 可用 {{SATOKEN}} 或 {{AUTH_TOKEN}} 引用；依實際認證需求自行設定。
# SATOKEN=
# AUTH_TOKEN=

# 前端本機 npm run dev；建議用 5174 避開 Archify 的 5173。
WEB_BASE_URL=http://127.0.0.1:5174
# 網頁預設使用已安裝的 Chrome。
PLAYWRIGHT_CHANNEL=chrome
# Android 僅供之後的推播測試；需明確選定裝置與已安裝 App。
APPIUM_URL=http://127.0.0.1:4723
ANDROID_UDID=
ANDROID_APP_PACKAGE=
# 可選覆寫網站截圖選項；0 不留圖、1 留圖。
# ARCHIFY_SCREENSHOTS=0

# 分析及報告目錄相對於本專案
ARCHIFY_ANALYSIS_DIR=analysis
ARCHIFY_API_TEST_DIR=tests/api
ARCHIFY_REPORT_DIR=reports
# 本機工具設定，不含認證；留空自動偵測
ARCHIFY_AI_CLI=
ARCHIFY_AI_MODEL=
ARCHIFY_ANDROID_SDK=
ARCHIFY_APPIUM_CLI=
